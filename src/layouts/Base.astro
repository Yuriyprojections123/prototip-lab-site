---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  bodyClass?: string;
}
const { title, description, noindex = false, jsonLd = [], bodyClass = '' } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const fullTitle = title.includes('ПРОТОТИП LAB') ? title : `${title} — ПРОТОТИП LAB`;
const ogImage = new URL('/og.png', site.url).href;

const business = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${site.url}/#studio`,
  name: site.name,
  description: 'Студия полного цикла: 3D-моделирование, 3D-сканирование и реверс-инжиниринг, прототипирование, печать FDM и SLA, покраска и сборка.',
  url: `${site.url}/`,
  image: ogImage,
  areaServed: { '@type': 'City', name: 'Москва' },
  address: { '@type': 'PostalAddress', addressLocality: 'Москва', addressCountry: 'RU', ...(site.address ? { streetAddress: site.address } : {}) },
  sameAs: [site.telegram.url],
  ...(site.email ? { email: site.email } : {}),
  knowsAbout: ['3D-моделирование', '3D-сканирование', 'Реверс-инжиниринг', '3D-печать FDM', '3D-печать SLA', 'Прототипирование'],
};
const ld = [business, ...jsonLd];
---
<!doctype html>
<html lang="ru" data-ym={site.metrikaId || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta name="theme-color" content="#e4e3de" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="ПРОТОТИП LAB" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>(function(d){d.classList.add('js');try{if(sessionStorage.getItem('pl-seen')||matchMedia('(prefers-reduced-motion: reduce)').matches)d.classList.add('seen')}catch(e){d.classList.add('seen')}})(document.documentElement);</script>
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
    {site.metrikaId && (
      /* Yandex Metrica slot — enabled only when PUBLIC_YM_ID is set at build time (README → Интеграции). */
      <script is:inline define:vars={{ id: site.metrikaId }}>
        (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();
        for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
        k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
        (window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");
        ym(Number(id), "init", { clickmap: true, trackLinks: true, accurateTrackBounce: true, webvisor: false });
      </script>
    )}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">К содержанию</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>

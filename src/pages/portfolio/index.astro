---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import CaseCard from '../../components/CaseCard.astro';
import CtaChapter from '../../components/CtaChapter.astro';
import { cases, tiles, categories, catColor } from '../../data/cases';

const all = [
  ...cases.map((c) => ({ key: c.slug, cat: c.cat, catLabel: c.catLabel, title: c.title, note: c.short, image: c.hero, alt: c.heroAlt, href: `/portfolio/${c.slug}/`, isCase: true })),
  ...tiles.map((t) => ({ key: t.title, cat: t.cat, catLabel: t.catLabel, title: t.title, note: undefined, image: t.image, alt: t.alt, href: `/uslugi/${t.service}/`, isCase: false })),
];
---
<Base title="Портфолио" description="Проекты ПРОТОТИП LAB: шлем по скану головы, серия из 120 наград для IT-конференции, восстановление снятой с производства детали — и направления студии.">
  <PageHead label="Портфолио" title="Идеи, ставшие объектами" lead="Каждый проект — путь от фотографии или эскиза до готового изделия. Три кейса разобраны подробно, остальное — примеры направлений." color="magenta" />

  <section class="chapter pf" data-portfolio aria-labelledby="pf-title">
    <div class="wrap">
      <h2 id="pf-title" class="sr-only">Работы</h2>
      <div class="pf__bar">
        <div class="pf__chips" role="group" aria-label="Фильтр по направлению">
          {categories.map((c) => <button type="button" class="filter-chip" data-filter={c.key} data-color={catColor[c.key]} aria-pressed={c.key === 'all' ? 'true' : 'false'}><i aria-hidden="true"></i>{c.label}</button>)}
        </div>
        <p class="t-label t-num pf__count" aria-live="polite"><span data-count>{String(all.length).padStart(2, '0')}</span> работ</p>
      </div>
      <div class="pf__grid">
        {all.map((it, i) => (
          <div class={`pf__item${i % 2 ? ' pf__item--low' : ''}`} data-cat={it.cat}>
            <CaseCard href={it.href} image={it.image} alt={it.alt} cat={it.catLabel} title={it.title} note={it.note} isCase={it.isCase} size={it.isCase ? 'l' : 'm'} color={catColor[it.cat]} sizes="(max-width: 767px) 100vw, 50vw" />
          </div>
        ))}
      </div>
      <p class="pf__empty t-body-l muted" data-empty hidden>В этой категории пока нет опубликованных работ.</p>
    </div>
  </section>

  <CtaChapter title="Хотите такой же — или совсем другой?" />
</Base>

<style>
  .pf { padding-top: 0; }
  .pf__bar {
    position: sticky; top: calc(var(--header-h) - 6px); z-index: 5; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px;
    padding: 6px 6px 6px 6px; margin-bottom: clamp(28px, 4vw, 56px); border-radius: var(--r-pill); background: var(--c-paper);
  }
  .pf__chips { display: flex; flex-wrap: wrap; gap: 2px; }
  .pf__chips .filter-chip { display: inline-flex; align-items: center; gap: 8px; background: transparent; }
  .pf__chips .filter-chip i { width: 8px; height: 8px; border-radius: 50%; background: var(--c); }
  .pf__chips .filter-chip[data-filter="all"] i { background: var(--spectrum-conic); }
  .pf__chips .filter-chip:hover { background: var(--c-fog); }
  .pf__chips .filter-chip[aria-pressed="true"] { background: var(--c-ink); color: var(--c-fog); }
  .pf__count { color: var(--c-muted); padding-right: 16px; }
  .pf__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--gap); row-gap: clamp(40px, 5vw, 80px); align-items: start; }
  .pf__item[hidden] { display: none; }
  .pf__item--low { margin-top: clamp(0px, 8vw, 140px); }
  .pf__grid:has(.pf__item[hidden]) .pf__item--low { margin-top: 0; }
  @media (max-width: 767px) {
    .pf__grid { grid-template-columns: 1fr; }
    .pf__item--low { margin-top: 0; }
    .pf__bar { border-radius: var(--r-card); top: 8px; }
    .pf__chips { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; width: 100%; mask-image: linear-gradient(90deg, #000 82%, transparent); }
    .pf__chips .filter-chip { flex: none; }
    .pf__count { padding: 0 0 6px 12px; }
  }
</style>

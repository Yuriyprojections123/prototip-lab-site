---
// Template aligned with 152-ФЗ. Operator details are placeholders until the owner provides them
// (clone-workspace/prototiplab/needs-confirmation.md #13). Do not publish without filling them in.
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { site } from '../data/site';
const operator = '[наименование оператора — ИП/ООО, ИНН, ОГРН]';
const operatorAddress = '[адрес оператора]';
const contact = site.email || `Telegram ${site.telegram.handle}`;
const sections = [
  { t: 'Общие положения', p: [
    `Настоящая политика определяет порядок обработки и защиты персональных данных пользователей сайта prototiplab.ru (далее — Сайт) в соответствии с Федеральным законом от 27.07.2006 № 152-ФЗ «О персональных данных».`,
    `Оператор персональных данных: ${operator}, адрес: ${operatorAddress} (далее — Оператор).`,
  ] },
  { t: 'Какие данные мы обрабатываем', p: [
    'Имя; контактные данные, которые вы указали сами (номер телефона, адрес электронной почты или имя пользователя в Telegram); описание задачи, параметры проекта и файлы, которые вы приложили к заявке.',
    'Технические данные: адрес страницы, с которой отправлена заявка. Если на Сайте подключена Яндекс Метрика, также обезличенные данные о посещении (cookie, сведения о браузере и устройстве).',
  ] },
  { t: 'Цели обработки', p: [
    'Ответ на заявку, подготовка предварительной оценки и коммерческого предложения, согласование и исполнение заказа, связь с вами по проекту.',
    'Анализ посещаемости Сайта в обезличенном виде — только если подключена веб-аналитика.',
  ] },
  { t: 'Правовые основания', p: [
    'Ваше согласие, которое вы даёте, отмечая соответствующий пункт в форме заявки (п. 1 ч. 1 ст. 6 152-ФЗ), а также необходимость заключения и исполнения договора, стороной которого вы являетесь (п. 5 ч. 1 ст. 6 152-ФЗ).',
  ] },
  { t: 'Как мы обрабатываем данные', p: [
    'Сбор, запись, систематизация, хранение, уточнение, использование, удаление и уничтожение — с использованием средств автоматизации и без них.',
    'Данные хранятся не дольше, чем этого требуют цели обработки, но не более трёх лет с момента последнего обращения, если более долгий срок не установлен законом или договором. Запись, систематизация и хранение персональных данных граждан РФ осуществляются с использованием баз данных, находящихся на территории Российской Федерации.',
    'Оператор не передаёт персональные данные третьим лицам, кроме случаев, предусмотренных законом, и лиц, которым поручена обработка по договору с Оператором (например, хостинг-провайдер) с соблюдением требований 152-ФЗ.',
  ] },
  { t: 'Ваши права', p: [
    'Вы можете получить сведения об обработке ваших данных, потребовать их уточнения, блокирования или уничтожения, а также отозвать согласие на обработку.',
    `Для этого напишите Оператору: ${contact}. Мы ответим в срок, установленный 152-ФЗ (не более 10 рабочих дней).`,
  ] },
  { t: 'Защита данных', p: [
    'Оператор принимает правовые, организационные и технические меры для защиты персональных данных от неправомерного доступа, изменения, раскрытия или уничтожения.',
  ] },
  { t: 'Изменения политики', p: [
    'Оператор может обновлять эту политику. Актуальная версия всегда доступна на этой странице.',
  ] },
];
---
<Base title="Политика конфиденциальности" description="Политика обработки персональных данных сайта prototiplab.ru в соответствии с 152-ФЗ.">
  <PageHead label="Политика конфиденциальности" title={"Политика конфиден\u00ADциальности"} lead="Как ПРОТОТИП LAB обрабатывает персональные данные, которые вы оставляете на сайте." />
  <section class="chapter pol" aria-label="Текст политики">
    <div class="wrap grid-12">
      <ol class="pol__body">
        {sections.map((s, i) => (
          <li class="pol__sec">
            <h2 class="t-h3"><span class="t-label t-num muted">{String(i + 1).padStart(2, '0')}</span> {s.t}</h2>
            {s.p.map((p) => <p class="t-body-l">{p}</p>)}
          </li>
        ))}
      </ol>
      <p class="pol__date t-label muted">Редакция от 26.09.2026</p>
    </div>
  </section>
</Base>

<style>
  .pol { padding-top: 0; }
  .pol__body { grid-column: 4 / span 7; display: grid; gap: 48px; }
  .pol__body { gap: var(--gap) !important; }
  .pol__sec { display: grid; gap: 16px; padding: 24px 26px 28px; border-radius: var(--r-card); background: var(--c-paper); }
  .pol__sec h2 { display: flex; gap: 16px; align-items: center; }
  .pol__sec h2 .t-num { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; background: var(--c-ink); color: var(--c-fog); flex: none; letter-spacing: 0; }
  .pol__sec p { max-width: 64ch; }
  .pol__date { grid-column: 4 / span 7; margin-top: 48px; }
  @media (max-width: 1023px) { .pol__body, .pol__date { grid-column: 1 / -1; } }
</style>

---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { site } from '../data/site';

const channels = [
  { k: 'Telegram', v: site.telegram.handle, note: 'Быстрее всего', href: site.telegram.url, ext: true, c: 'cyan' },
  ...(site.email ? [{ k: 'Почта', v: site.email, note: 'Для документов и больших файлов', href: `mailto:${site.email}`, ext: false, c: 'orange' }] : []),
  ...(site.whatsapp ? [{ k: 'WhatsApp', v: site.whatsapp, note: '', href: `https://wa.me/${site.whatsapp}`, ext: true, c: 'lime' }] : []),
  { k: 'Бриф на сайте', v: 'Рассчитать проект', note: 'Шесть шагов, файлы и фото', href: '/raschet/', ext: false, c: 'magenta' },
];
---
<Base title="Контакты" description="Как связаться с ПРОТОТИП LAB: Telegram @prototiplab или бриф на сайте. Москва, приём объектов на сканирование по записи.">
  <PageHead label="Контакты" title="Расскажите, что хотите создать" lead="На первом этапе достаточно идеи, фотографии или эскиза. Ответим в течение рабочего дня с предварительной оценкой." color="cyan" />
  <section class="chapter ct" aria-label="Каналы связи">
    <div class="wrap grid-12">
      <ul class="ct__list">
        {channels.map((c, i) => (
          <li>
            <a href={c.href} class="ct__card" data-color={c.c} data-flood {...(c.ext ? { target: '_blank', rel: 'noopener' } : {})}>
              <span class="ct__top"><span class="chip ct__k"><i></i>{c.k}</span><span class="t-num ct__n">0{i + 1}</span></span>
              <span class="ct__v">{c.v}</span>
              <span class="ct__note">{c.note}</span>
              <span class="ct__arr" aria-hidden="true">{c.ext ? '↗' : '→'}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="ct__place">
        <p class="chip"><i style="--c: var(--f-lime)"></i>Студия</p>
        <p class="t-h3">{site.city}{site.address && `, ${site.address}`}</p>
        <p class="muted">{site.scanIntake}. Адрес пришлём после записи.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .ct { padding-top: 0; }
  .ct__list { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: var(--gap); }
  .ct__card {
    position: relative; isolation: isolate; overflow: hidden; display: grid; gap: 16px; min-height: 280px; align-content: space-between;
    padding: 18px 22px 26px; border-radius: var(--r-card); background: var(--c-paper); transition: color 0.5s var(--ease-out);
  }
  .ct__card::before { content: ""; position: absolute; z-index: -1; left: var(--mx, 50%); top: var(--my, 100%); width: 10px; height: 10px; margin: -5px; border-radius: 50%; background: var(--c); transform: scale(0); transition: transform 0.8s var(--ease-out); }
  .ct__card:hover::before, .ct__card:focus-visible::before { transform: scale(180); }
  .ct__card:hover, .ct__card:focus-visible { color: var(--c-on); }
  .ct__top { display: flex; justify-content: space-between; align-items: center; }
  .ct__k { background: var(--c-fog); color: var(--c-ink); }
  .ct__n { font-size: 13px; }
  .ct__v { font-size: clamp(34px, 4.2vw, 76px); line-height: 1; letter-spacing: -0.05em; font-weight: 380; overflow-wrap: anywhere; padding-right: 56px; }
  .ct__note { opacity: 0.75; }
  .ct__arr { position: absolute; right: 18px; bottom: 18px; width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; font-size: 20px; background: var(--c-ink); color: var(--c-fog); transition: transform 0.5s var(--ease-out); }
  .ct__card:hover .ct__arr { transform: scale(1.08); }
  .ct__place { grid-column: 1 / span 5; margin-top: clamp(32px, 4vw, 64px); display: grid; gap: 12px; justify-items: start; }
  @media (max-width: 1023px) { .ct__place { grid-column: 1 / -1; } }
</style>

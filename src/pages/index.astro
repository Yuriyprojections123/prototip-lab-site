---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ServicesIndex from '../components/ServicesIndex.astro';
import ProcessScroll from '../components/ProcessScroll.astro';
import Compare from '../components/Compare.astro';
import CaseCard from '../components/CaseCard.astro';
import CtaChapter from '../components/CtaChapter.astro';
import { cases, catColor } from '../data/cases';
import { audiences } from '../data/site';
import photo from '../assets/photos/figurine-portrait.webp';
import sketch from '../assets/photos/modeling.webp';

const principles = [
  { t: 'Полный цикл', d: 'От концепта и промышленного дизайна до покраски, сборки и доставки готового изделия.', c: 'cyan' },
  { t: 'Инженерная точность', d: 'Реверс-инжиниринг, CAD-реконструкция и контроль геометрии на каждом этапе.', c: 'blue' },
  { t: 'Дизайн-мышление', d: 'Продумываем форму, конструкцию и материал так, чтобы вещь хотелось взять в руки.', c: 'magenta' },
  { t: 'Один экземпляр или серия', d: 'Единичные объекты и малые тиражи. Готовая цифровая модель ускоряет повторный запуск.', c: 'lime' },
];
const audColors = ['cyan', 'blue', 'magenta', 'orange', 'yellow', 'lime'];
const [c1, c2, c3] = cases;
---
<Base
  title="ПРОТОТИП LAB — 3D-моделирование, сканирование и производство изделий в Москве"
  description="Студия полного цикла в Москве: 3D-моделирование, 3D-сканирование и реверс-инжиниринг, печать FDM и SLA, покраска и сборка. Фигурки, мерч, косплей, прототипы.">
  <div class="loader" data-loader aria-hidden="true">
    <p class="t-label">ПРОТОТИП LAB · прогрев экструдера</p>
    <div class="loader__bar"><span data-loader-bar></span></div>
    <p class="loader__n t-num" data-loader-count>000</p>
  </div>

  <Hero />

  <section class="chapter stmt" aria-labelledby="stmt-title">
    <div class="wrap">
      <p class="chip stmt__label"><i style="--c: var(--f-blue)"></i>Почему мы</p>
      <h2 id="stmt-title" class="t-lead stmt__lead" data-reveal="rise">
        <span>Большинство проектов начинается с <span class="pill-img" aria-hidden="true"><Image src={photo} alt="" width={160} height={96} quality={70} /></span> фотографии, <span class="pill-img" aria-hidden="true"><Image src={sketch} alt="" width={160} height={96} quality={70} /></span> рисунка или слов. Дизайнеры, инженеры и мастера производства работают как одна команда — поэтому объект <span class="grad-text">выглядит убедительно</span> и работает так, как задумано.</span>
      </h2>
      <ol class="stmt__list" data-reveal="rise">
        {principles.map((p, i) => (
          <li class="stmt__item" data-color={p.c}>
            <span class="stmt__n t-num">0{i + 1}</span>
            <h3 class="t-h3">{p.t}</h3>
            <p class="muted">{p.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <ServicesIndex />

  <ProcessScroll />

  <Compare />

  <section class="chapter chapter--deep works" aria-labelledby="works-title">
    <div class="wrap">
      <div class="grid-12 works__head">
        <p class="chip works__label"><i style="--c: var(--f-lime)"></i>Избранные проекты</p>
        <h2 id="works-title" class="t-h2 works__title balance" data-reveal="lines">Идеи, ставшие объектами</h2>
        <a href="/portfolio/" class="btn btn--ghost btn--sm works__all">Всё портфолио <span class="arr" aria-hidden="true">→</span></a>
      </div>
      <div class="grid-12 works__grid">
        <div class="works__a"><CaseCard size="l" href={`/portfolio/${c1.slug}/`} image={c1.hero} alt={c1.heroAlt} cat={c1.catLabel} title={c1.title} note={c1.short} color={catColor[c1.cat]} sizes="(max-width: 1023px) 100vw, 58vw" /></div>
        <div class="works__b"><CaseCard href={`/portfolio/${c2.slug}/`} image={c2.hero} alt={c2.heroAlt} cat={c2.catLabel} title={c2.title} note={c2.short} color={catColor[c2.cat]} sizes="(max-width: 1023px) 100vw, 40vw" /></div>
        <div class="works__c"><CaseCard href={`/portfolio/${c3.slug}/`} image={c3.hero} alt={c3.heroAlt} cat={c3.catLabel} title={c3.title} note={c3.short} color={catColor[c3.cat]} sizes="(max-width: 1023px) 100vw, 40vw" /></div>
      </div>
    </div>
  </section>

  <section class="chapter aud" aria-labelledby="aud-title">
    <div class="wrap grid-12 aud__head">
      <p class="chip aud__label"><i style="--c: var(--f-yellow)"></i>Для кого</p>
      <h2 id="aud-title" class="t-h2 aud__title balance" data-reveal="lines">Одна студия. Разные масштабы.</h2>
      <p class="t-body-l muted aud__text">Работаем с компаниями и частными клиентами — от единичного подарка до серийного мерча и инженерных задач.</p>
    </div>
    <ul class="sr-only">{audiences.map((a) => <li>{a}</li>)}</ul>
    <div class="aud__marquee" aria-hidden="true">
      {[0, 1].map((row) => (
        <div class={`aud__row aud__row--${row}`}>
          {[0, 1].map(() => (
            <div class="aud__set">
              {(row ? [...audiences].reverse() : audiences).map((a, i) => <span class="aud__pill" data-color={audColors[(i + row * 3) % audColors.length]}><i></i>{a}</span>)}
            </div>
          ))}
        </div>
      ))}
    </div>
  </section>

  <CtaChapter />
</Base>

<style>
  .loader { display: none; }
  :global(html.js:not(.seen)) .loader {
    position: fixed; inset: 0; z-index: 300; background: var(--c-ink); color: var(--c-fog);
    display: flex; flex-direction: column; justify-content: space-between; gap: 24px; padding: 24px var(--margin);
    transition: clip-path 1s var(--ease-out); clip-path: inset(0 0 0 0 round 0);
  }
  .loader.is-done { clip-path: inset(0 var(--inset) 100% var(--inset) round 32px) !important; }
  .loader__bar { height: 10px; border-radius: 10px; background: var(--c-ink-3); overflow: hidden; margin-top: auto; }
  .loader__bar span { display: block; height: 100%; width: 100%; border-radius: 10px; background: var(--spectrum); transform-origin: 0 50%; transform: scaleX(0); }
  .loader__n { font-size: clamp(96px, 22vw, 320px); line-height: .8; letter-spacing: -.06em; align-self: flex-end; font-family: var(--f-sans); font-weight: 350; }

  .stmt__label { margin-bottom: clamp(24px, 3vw, 40px); }
  .stmt__lead { max-width: 30ch; font-size: clamp(28px, 3.6vw, 64px); line-height: 1.08; letter-spacing: -0.035em; font-weight: 380; }
  .pill-img { display: inline-block; vertical-align: -0.08em; width: 1.7em; height: 0.92em; border-radius: 999px; overflow: hidden; background: var(--c-fog-2); }
  .pill-img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .stmt__list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gap); margin-top: clamp(40px, 5vw, 80px); }
  .stmt__item { display: grid; gap: 12px; align-content: start; padding: 20px 22px 26px; border-radius: var(--r-card); background: var(--c-paper); }
  .stmt__n { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; background: var(--c); color: var(--c-on); font-size: 13px; margin-bottom: 18px; }

  .works__head { align-items: end; margin-bottom: clamp(32px, 4vw, 64px); }
  .works__label { grid-column: 1 / span 3; align-self: start; justify-self: start; }
  .works__title { grid-column: 4 / span 6; }
  .works__all { grid-column: 10 / span 3; justify-self: end; }
  .works__grid { row-gap: clamp(32px, 4vw, 56px); }
  .works__a { grid-column: 1 / span 7; grid-row: 1 / span 2; }
  .works__b { grid-column: 8 / span 5; }
  .works__c { grid-column: 8 / span 5; }

  .aud__head { align-items: end; margin-bottom: clamp(32px, 4vw, 56px); }
  .aud__label { grid-column: 1 / span 3; align-self: start; justify-self: start; }
  .aud__title { grid-column: 4 / span 6; }
  .aud__text { grid-column: 4 / span 6; }
  .aud__marquee { display: grid; gap: 10px; overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .aud__row { display: flex; width: max-content; animation: marquee 48s linear infinite; }
  .aud__row--1 { animation-direction: reverse; animation-duration: 56s; }
  .aud__set { display: flex; gap: 10px; padding-right: 10px; }
  .aud__pill { display: inline-flex; align-items: center; gap: 14px; min-height: clamp(56px, 6vw, 96px); padding: 0 clamp(22px, 2.4vw, 40px); border-radius: var(--r-pill); background: var(--c-paper); font-size: clamp(22px, 2.4vw, 40px); letter-spacing: -0.03em; white-space: nowrap; }
  .aud__pill i { width: 0.5em; height: 0.5em; border-radius: 50%; background: var(--c); }
  .aud__marquee:hover .aud__row { animation-play-state: paused; }
  @keyframes marquee { to { transform: translateX(-50%); } }
  /* reduced motion: the global reset froze the rows; keep them drifting, slower */
  @media (prefers-reduced-motion: reduce) {
    .aud__row { animation-duration: 140s !important; animation-iteration-count: infinite !important; }
    .aud__row--1 { animation-duration: 160s !important; }
  }

  @media (max-width: 1023px) {
    .stmt__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .works__label, .works__title, .aud__label, .aud__title, .aud__text { grid-column: 1 / -1; }
    .works__all { grid-column: 1 / -1; justify-self: start; }
    .works__a, .works__b, .works__c { grid-column: 1 / -1; grid-row: auto; }
  }
  @media (max-width: 560px) { .stmt__list { grid-template-columns: 1fr; } }
</style>

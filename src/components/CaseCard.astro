---
import { Image } from 'astro:assets';
interface Props { href: string; image: ImageMetadata; alt: string; cat: string; title: string; note?: string; size?: 'l' | 'm' | 's'; isCase?: boolean; dataCat?: string; sizes?: string; color?: string }
const { href, image, alt, cat, title, note, size = 'm', isCase = true, dataCat, sizes = '(max-width: 767px) 100vw, 50vw', color = 'lime' } = Astro.props;
---
<article class={`case-card case-card--${size}`} data-cat={dataCat} data-color={color}>
  <a href={href} class="case-card__link">
    <div class="case-card__media frame" data-reveal="clip">
      <Image src={image} alt={alt} widths={[480, 800, 1200]} sizes={sizes} loading="lazy" decoding="async" quality={74} />
      <span class="chip case-card__badge"><i></i>{isCase ? 'Кейс' : 'Направление'} · {cat}</span>
      <span class="case-card__go" aria-hidden="true">→</span>
    </div>
    <div class="case-card__meta">
      <h3 class="case-card__title t-h3">{title}</h3>
      {note && <p class="muted case-card__note">{note}</p>}
      <span class="sr-only">{isCase ? 'Читать кейс' : 'Об услуге'}</span>
    </div>
  </a>
</article>

<style>
  .case-card__link { display: grid; gap: 16px; }
  .case-card__media { aspect-ratio: 4 / 3; border-radius: var(--r-card); box-shadow: 0 0 0 0 var(--c); transition: box-shadow 0.6s var(--ease-out); }
  .case-card--l .case-card__media { aspect-ratio: 16 / 11; }
  .case-card__media :global(img) { transition: transform 1.1s var(--ease-out); }
  .case-card__link:hover .case-card__media { box-shadow: 0 0 0 6px var(--c); }
  .case-card__link:hover .case-card__media :global(img) { transform: scale(1.05); }
  .case-card__badge { position: absolute; left: 12px; top: 12px; z-index: 2; max-width: calc(100% - 24px); white-space: normal; line-height: 1.25; padding-block: 6px; }
  .case-card__go {
    position: absolute; right: 14px; bottom: 14px; z-index: 2; width: 52px; height: 52px; border-radius: 50%;
    display: grid; place-items: center; font-size: 20px; background: var(--c); color: var(--c-on);
    transform: scale(0.6) rotate(-45deg); opacity: 0; transition: transform 0.6s var(--ease-out), opacity 0.4s var(--ease-out);
  }
  .case-card__link:hover .case-card__go, .case-card__link:focus-visible .case-card__go { transform: none; opacity: 1; }
  .case-card__meta { display: grid; gap: 8px; padding-inline: 6px; }
  .case-card__title { max-width: 28ch; }
  .case-card__note { max-width: 48ch; }
  @media (hover: none) { .case-card__go { transform: none; opacity: 1; width: 44px; height: 44px; } }
</style>

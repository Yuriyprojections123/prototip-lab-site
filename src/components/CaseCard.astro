---
import { Image } from 'astro:assets';
interface Props { href: string; image: ImageMetadata; alt: string; cat: string; title: string; note?: string; size?: 'l' | 'm' | 's'; isCase?: boolean; dataCat?: string; sizes?: string }
const { href, image, alt, cat, title, note, size = 'm', isCase = true, dataCat, sizes = '(max-width: 767px) 100vw, 50vw' } = Astro.props;
---
<article class={`case-card case-card--${size}`} data-cat={dataCat}>
  <a href={href} class="case-card__link">
    <div class="case-card__media frame" data-reveal="clip">
      <Image src={image} alt={alt} widths={[480, 800, 1200]} sizes={sizes} loading="lazy" decoding="async" quality={74} />
      <span class="case-card__badge t-label">{isCase ? 'Кейс' : 'Иллюстрация направления'}</span>
    </div>
    <div class="case-card__meta">
      <p class="t-label muted">{cat}</p>
      <h3 class="case-card__title t-h3">{title}</h3>
      {note && <p class="muted case-card__note">{note}</p>}
      <span class="t-label case-card__more">{isCase ? 'Читать кейс' : 'Об услуге'} <span aria-hidden="true">→</span></span>
    </div>
  </a>
</article>

<style>
  .case-card { border-radius: 0; box-shadow: none; }
  .case-card__link { display: grid; gap: 18px; }
  .case-card__media { aspect-ratio: 4 / 3; }
  .case-card--l .case-card__media { aspect-ratio: 16 / 11; }
  .case-card__media :global(img) { transition: transform .9s var(--ease-out), clip-path .9s var(--ease-out); clip-path: inset(0); }
  .case-card__link:hover .case-card__media :global(img) { transform: scale(1.04); clip-path: inset(2.5%); }
  .case-card__badge { position: absolute; left: 12px; top: 12px; background: var(--c-primer); color: var(--c-graphite); padding: 6px 8px; z-index: 2; }
  .case-card__meta { display: grid; gap: 8px; }
  .case-card__title { max-width: 26ch; }
  .case-card__note { max-width: 48ch; }
  .case-card__more { margin-top: 6px; display: inline-flex; gap: 8px; }
  .case-card__more span { transition: transform var(--d-fast) var(--ease-hover); }
  .case-card__link:hover .case-card__more span { transform: translateX(6px); color: var(--c-amber); }
</style>

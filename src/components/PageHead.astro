---
// Inner-page opening: breadcrumb label, display title, lead, optional right-hand slot.
interface Props { label: string; title: string; lead?: string; crumbs?: { href: string; label: string }[]; dark?: boolean }
const { label, title, lead, crumbs = [], dark = false } = Astro.props;
---
<section class:list={['chapter', 'phead', { 'chapter--dark': dark }]} aria-labelledby="page-title">
  <div class="wrap grid-12 phead__grid">
    <div class="phead__main">
      <nav aria-label="Навигационная цепочка" class="phead__crumbs t-label">
        <a href="/" class="link-u">Главная</a>
        {crumbs.map((c) => <><span aria-hidden="true">/</span><a href={c.href} class="link-u">{c.label}</a></>)}
        <span aria-hidden="true">/</span><span aria-current="page" class="muted">{label}</span>
      </nav>
      <h1 id="page-title" class="t-display balance phead__title" data-reveal="lines">{title}</h1>
      {lead && <p class="t-body-l muted phead__lead pretty">{lead}</p>}
      <slot name="actions" />
    </div>
    <div class="phead__aside"><slot /></div>
  </div>
</section>

<style>
  .phead { padding-top: calc(var(--header-h) + clamp(32px, 5vw, 80px)); }
  .phead__grid { align-items: end; }
  .phead__main { grid-column: 1 / span 7; display: grid; gap: 28px; align-content: start; }
  .phead__crumbs { display: flex; flex-wrap: wrap; gap: 8px; color: inherit; }
  .phead__crumbs a { padding: 4px 0; }
  .phead__title { max-width: 16ch; }
  .phead__lead { max-width: 52ch; }
  .phead__aside { grid-column: 8 / span 5; }
  .phead__aside:empty { display: none; }
  @media (max-width: 1023px) { .phead__main, .phead__aside { grid-column: 1 / -1; } }
</style>

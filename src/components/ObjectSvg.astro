---
// Static render of «Образец» in any material state, drawn from the same profile as the 3D scene.
// Used as the hero/process fallback (low-end, reduced motion, no WebGL, no JS) and as the step frames on mobile.
import { silhouettePath, profilePoints, svgScale, HEIGHT, INLAY_Y, radiusAt } from '../scripts/object/profile';
interface Props { state: 0 | 1 | 2 | 3 | 4; class?: string; label?: string }
const { state, class: cls = '', label } = Astro.props;
const W = 400, H = 460, PAD = 30;
const k = svgScale(H, PAD);
const path = silhouettePath(W, H, PAD);
const pts = profilePoints(4);
const cx = W / 2;
const Y = (y: number) => H - PAD - y * k;
const layers = Array.from({ length: 64 }, (_, i) => (i + 0.5) * (HEIGHT / 64));
const rings = pts.filter((_, i) => i % 2 === 0);
const inlayR = radiusAt(INLAY_Y) * k;
const uid = `o${state}${Math.random().toString(36).slice(2, 7)}`;
---
<svg class={`obj obj--${state} ${cls}`} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={label ?? 'Образец — объект студии'}>
  <defs><clipPath id={uid}><path d={path} /></clipPath></defs>
  <ellipse cx={cx} cy={H - PAD + 6} rx={1.4 * k} ry={10} fill="#232321" />
  {state === 0 && (
    <g fill="none" stroke="#141413" stroke-width="1.4" stroke-linecap="round">
      <path d={path} class="obj__sketch" pathLength="1" />
      <line x1={cx} y1={PAD - 10} x2={cx} y2={H - PAD + 14} stroke-dasharray="6 6" stroke-width="1" opacity=".5" />
    </g>
  )}
  {state === 1 && (
    <g fill="none" stroke="#141413" stroke-width="1" opacity=".75">
      <path d={path} />
      {rings.map(([r, y]) => <ellipse cx={cx} cy={Y(y)} rx={r * k} ry={r * k * 0.18} />)}
      {[-0.7, -0.35, 0, 0.35, 0.7].map((f) => <path d={`M${pts.map(([r, y]) => `${(cx + f * r * k).toFixed(1)},${Y(y).toFixed(1)}`).join('L')}`} />)}
    </g>
  )}
  {state === 2 && (
    <g clip-path={`url(#${uid})`}>
      <path d={path} fill="#d8d3c7" />
      {layers.map((y) => <line x1="0" x2={W} y1={Y(y)} y2={Y(y)} stroke="#141413" stroke-opacity=".16" stroke-width="1.6" />)}
      <rect x="0" y={Y(HEIGHT) - 2} width={W} height="4" fill="#ff5a1f" />
    </g>
  )}
  {state === 3 && (
    <g clip-path={`url(#${uid})`}>
      <path d={path} fill="#8e8c86" />
      <rect x={cx - 1.2 * k} y="0" width={0.55 * k} height={H} fill="#fff" opacity=".18" />
    </g>
  )}
  {state === 4 && (
    <g clip-path={`url(#${uid})`}>
      <path d={path} fill="#1d1d1b" />
      <rect x={cx - 0.62 * k} y="0" width={0.16 * k} height={H} fill="#fff" opacity=".22" />
      <rect x={cx + 0.3 * k} y="0" width={0.06 * k} height={H} fill="#fff" opacity=".1" />
      <rect x="0" y={Y(INLAY_Y) - 3} width={W} height="6" fill="#ff5a1f" />
    </g>
  )}
  {state >= 2 && <path d={path} fill="none" stroke="#141413" stroke-opacity=".35" />}
  {state === 4 && <ellipse cx={cx} cy={Y(INLAY_Y)} rx={inlayR} ry={inlayR * 0.16} fill="none" stroke="#ff5a1f" stroke-width="1.5" stroke-opacity=".6" />}
</svg>

<style>
  .obj { width: 100%; height: auto; overflow: visible; }
  .obj__sketch { stroke-dasharray: 1; stroke-dashoffset: 0; }
</style>

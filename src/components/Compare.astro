---
import { tech } from '../data/site';
interface Props { headingLevel?: 'h2' | 'h3'; compact?: boolean }
const { headingLevel = 'h2', compact = false } = Astro.props;
const H = headingLevel;
const keys = Object.keys(tech.rowLabels) as (keyof typeof tech.rowLabels)[];
---
<section class:list={['chapter', 'compare-ch', { 'compare-ch--compact': compact }]} aria-labelledby="compare-title">
  <div class="wrap grid-12">
    <div class="compare-ch__head">
      <p class="t-label muted">Технологии</p>
      <H id="compare-title" class="t-h2 balance" data-reveal="lines">FDM или SLA — выбираем по задаче, а не по привычке.</H>
      <p class="t-body-l muted measure-body">Подбираем технологию под функцию, поверхность, размер и бюджет конкретного объекта. Потяните разделитель: слева — поверхность FDM, справа — SLA, в одинаковом масштабе.</p>
    </div>

    <div class="compare" data-compare>
      <div class="compare__view">
        <canvas class="compare__canvas" aria-hidden="true"></canvas>
        <noscript><p class="compare__noscript">Сравнение поверхностей работает с включённым JavaScript.</p></noscript>
        <p class="t-label compare__tag compare__tag--l"><b>FDM</b> <span class="t-num">слой 0,2 мм</span></p>
        <p class="t-label compare__tag compare__tag--r"><b>SLA</b> <span class="t-num">слой 0,05 мм</span></p>
        <div class="compare__handle" role="slider" tabindex="0" aria-label="Граница сравнения FDM и SLA" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" aria-valuetext="50% — FDM слева, SLA справа" data-handle>
          <span class="compare__grip" aria-hidden="true"><svg viewBox="0 0 20 10" width="20" height="10"><path d="M0 5 6 0v10zM20 5l-6-5v10z" fill="currentColor"/></svg></span>
        </div>
        <p class="t-label compare__hint" aria-hidden="true">Наведите — лупа ×3</p>
      </div>

      <div class="compare__table">
        <div class="compare__toggle" role="group" aria-label="Показать в таблице">
          <button type="button" class="filter-chip" data-col="both" aria-pressed="true">Обе</button>
          <button type="button" class="filter-chip" data-col="fdm" aria-pressed="false">FDM</button>
          <button type="button" class="filter-chip" data-col="sla" aria-pressed="false">SLA</button>
        </div>
        <table data-show="both">
          <caption class="sr-only">Сравнение FDM и SLA — типичные значения для технологий</caption>
          <thead>
            <tr><th scope="col"><span class="sr-only">Параметр</span></th><th scope="col" class="c-fdm">FDM · {tech.fdm.title}</th><th scope="col" class="c-sla">SLA · {tech.sla.title}</th></tr>
          </thead>
          <tbody>
            {keys.map((k) => (
              <tr>
                <th scope="row" class="t-label">{tech.rowLabels[k]}</th>
                <td class="c-fdm">{tech.fdm.rows[k]}</td>
                <td class="c-sla">{tech.sla.rows[k]}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="caption">Типичные значения для технологий. Конкретный принтер и материал подбираем под задачу.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .compare-ch__head { grid-column: 1 / span 7; display: grid; gap: 24px; }
  .compare { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); row-gap: 32px; margin-top: clamp(16px, 3vw, 40px); border-radius: 0; }
  .compare__view { grid-column: 1 / span 7; position: relative; aspect-ratio: 4 / 3; background: var(--c-primer-deep); overflow: hidden; touch-action: pan-y; cursor: crosshair; }
  .compare__canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .compare__noscript { position: absolute; inset: auto 16px 16px; }
  .compare__tag { position: absolute; top: 16px; margin: 0; display: flex; gap: 10px; background: var(--c-primer); padding: 6px 8px; }
  .compare__tag--l { left: 16px; } .compare__tag--r { right: 16px; }
  .compare__hint { position: absolute; left: 16px; bottom: 16px; margin: 0; color: var(--c-ink-muted); }
  .compare__handle { position: absolute; top: 0; bottom: 0; left: 50%; width: 44px; margin-left: -22px; cursor: ew-resize; display: flex; align-items: center; justify-content: center; touch-action: none; }
  .compare__handle::before { content: ""; position: absolute; top: 0; bottom: 0; left: 50%; width: 2px; margin-left: -1px; background: var(--c-amber); }
  .compare__grip { position: relative; background: var(--c-graphite); color: var(--c-primer); padding: 10px 8px; border-radius: 2px; letter-spacing: 0; }
  .compare__table { grid-column: 8 / span 5; display: grid; gap: 20px; align-content: start; }
  .compare__toggle { display: flex; gap: 6px; }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; vertical-align: top; padding: 14px 10px 14px 0; border-bottom: 1px solid var(--c-line); font-weight: 400; }
  thead th { font-family: var(--f-mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--c-ink-muted); }
  tbody th { color: var(--c-ink-muted); width: 30%; }
  td { transition: opacity var(--d-fast) var(--ease-hover); }
  table[data-show="fdm"] .c-sla, table[data-show="sla"] .c-fdm { opacity: .22; }

  @media (max-width: 1023px) {
    .compare-ch__head, .compare__view, .compare__table { grid-column: 1 / -1; }
  }
  @media (max-width: 767px) {
    .compare { grid-template-columns: 1fr; }
    .compare__hint { display: none; }
  }
</style>

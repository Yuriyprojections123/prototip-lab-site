---
import { getImage } from 'astro:assets';
import { services } from '../data/services';
interface Props { title?: string; label?: string; level?: 'h2' | 'h1'; showAll?: boolean }
const { title = 'Шесть направлений. Одна мастерская.', label = 'Направления', showAll = true } = Astro.props;
const previews = await Promise.all(services.map((s) => getImage({ src: s.image, width: 520, format: 'webp', quality: 72 })));
---
<section class="chapter svc" aria-labelledby="svc-title">
  <div class="wrap">
    <div class="svc__head grid-12">
      <p class="t-label muted svc__label">{label}</p>
      <h2 id="svc-title" class="t-h2 balance svc__title" data-reveal="lines">{title}</h2>
      {showAll && <a href="/uslugi/" class="t-label link-u svc__all">Все услуги →</a>}
    </div>
    <ol class="svc__list" data-index-hover>
      {services.map((s, i) => (
        <li>
          <a href={`/uslugi/${s.slug}/`} class="service-row" data-preview={previews[i].src}>
            <span class="t-label t-num service-row__n">{s.n}</span>
            <span class="service-row__name t-h3">{s.name}</span>
            <span class="service-row__short muted">{s.short}</span>
            <span class="service-row__area t-label muted">{s.area}</span>
            <span class="service-row__arr" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
  <div class="svc__float" aria-hidden="true"><img alt="" width="260" height="195" decoding="async" /></div>
</section>

<style>
  .svc__head { align-items: end; margin-bottom: clamp(32px, 4vw, 64px); }
  .svc__label { grid-column: 1 / span 3; }
  .svc__title { grid-column: 4 / span 7; }
  .svc__all { grid-column: 11 / span 2; justify-self: end; padding: 12px 0; }
  .svc__list { border-top: 1px solid var(--c-line-strong); }
  .service-row {
    position: relative; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); align-items: baseline;
    padding: clamp(20px, 2.2vw, 32px) 0; border-bottom: 1px solid var(--c-line-strong); border-radius: 0; box-shadow: none; isolation: isolate;
  }
  .service-row::before { content: ""; position: absolute; inset: 0 calc(var(--margin) * -1); background: var(--c-graphite); z-index: -1; transform: scaleY(0); transform-origin: 50% 100%; transition: transform .5s var(--ease-out); }
  .service-row__n { grid-column: 1 / span 1; color: var(--c-ink-muted); transition: color var(--d-fast) var(--ease-hover); }
  .service-row__name { grid-column: 2 / span 5; transition: transform .5s var(--ease-out), color var(--d-fast) var(--ease-hover); }
  .service-row__short { grid-column: 7 / span 4; max-width: 42ch; transition: color var(--d-fast) var(--ease-hover); }
  .service-row__area { grid-column: 11 / span 1; transition: color var(--d-fast) var(--ease-hover); }
  .service-row__arr { grid-column: 12 / span 1; justify-self: end; font-size: 24px; transition: transform .5s var(--ease-out), color var(--d-fast) var(--ease-hover); }
  .service-row:hover::before, .service-row:focus-visible::before { transform: scaleY(1); }
  .service-row:hover, .service-row:focus-visible { color: var(--c-primer); }
  .service-row:hover .service-row__short, .service-row:hover .service-row__area, .service-row:focus-visible .service-row__short { color: var(--c-primer-muted); }
  .service-row:hover .service-row__n, .service-row:focus-visible .service-row__n { color: var(--c-amber); }
  .service-row:hover .service-row__name { transform: translateX(12px); }
  .service-row:hover .service-row__arr { transform: translateX(-6px) rotate(-45deg); color: var(--c-amber); }
  .service-row:focus-visible { outline-offset: -2px; }

  .svc__float { position: fixed; left: 0; top: 0; width: 260px; aspect-ratio: 4 / 3; pointer-events: none; z-index: 40; opacity: 0; clip-path: inset(50% 0 50% 0); transition: opacity .3s var(--ease-hover), clip-path .6s var(--ease-out); }
  .svc__float img { width: 100%; height: 100%; object-fit: cover; }
  .svc__float.is-on { opacity: 1; clip-path: inset(0 0 0 0); }

  @media (max-width: 1023px) {
    .svc__label, .svc__title { grid-column: 1 / -1; }
    .svc__all { grid-column: 1 / -1; justify-self: start; }
    .service-row__n { grid-column: 1 / span 1; }
    .service-row__name { grid-column: 2 / span 10; }
    .service-row__short { grid-column: 2 / span 10; margin-top: 8px; }
    .service-row__area { display: none; }
    .service-row__arr { grid-column: 12; grid-row: 1; }
  }
  @media (max-width: 767px) {
    .service-row { grid-template-columns: 40px 1fr 24px; }
    .service-row__n { grid-column: 1; } .service-row__name { grid-column: 2; } .service-row__short { grid-column: 2; } .service-row__arr { grid-column: 3; }
    .svc__float { display: none; }
  }
</style>

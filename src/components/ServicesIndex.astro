---
import { Image } from 'astro:assets';
import { services } from '../data/services';
interface Props { title?: string; label?: string; showAll?: boolean }
const { title = 'Шесть направлений. Одна мастерская.', label = 'Направления', showAll = true } = Astro.props;
---
<section class="chapter svc" aria-labelledby="svc-title">
  <div class="wrap">
    <div class="svc__head grid-12">
      <p class="chip svc__label"><i style="--c: var(--f-cyan)"></i>{label}</p>
      <h2 id="svc-title" class="t-h2 balance svc__title" data-reveal="lines">{title}</h2>
      {showAll && <a href="/uslugi/" class="btn btn--ghost btn--sm svc__all">Все услуги <span class="arr" aria-hidden="true">→</span></a>}
    </div>
    <ol class="svc__grid" data-reveal="rise">
      {services.map((s) => (
        <li>
          <a href={`/uslugi/${s.slug}/`} class="svc-card" data-color={s.color} data-flood>
            <span class="svc-card__top">
              <span class="svc-card__n t-num">{s.n}</span>
              <span class="chip svc-card__area"><i></i>{s.area}</span>
            </span>
            <span class="svc-card__media">
              <Image src={s.image} alt="" widths={[360, 560, 800]} sizes="(max-width: 767px) 92vw, (max-width: 1023px) 46vw, 31vw" loading="lazy" decoding="async" quality={72} />
            </span>
            <span class="svc-card__name t-h3">{s.name}</span>
            <span class="svc-card__short">{s.short}</span>
            <span class="svc-card__go" aria-hidden="true"><span>→</span></span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .svc__head { align-items: end; margin-bottom: clamp(32px, 4vw, 64px); }
  .svc__label { grid-column: 1 / span 3; align-self: start; justify-self: start; }
  .svc__title { grid-column: 4 / span 7; }
  .svc__all { grid-column: 11 / span 2; justify-self: end; }
  .svc__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap); }
  .svc-card {
    position: relative; isolation: isolate; overflow: hidden; height: 100%;
    display: grid; grid-template-rows: auto auto 1fr auto; gap: 14px; padding: 14px 14px 22px;
    border-radius: var(--r-card); background: var(--c-paper); color: var(--c-ink);
    transition: color 0.5s var(--ease-out);
  }
  .svc-card::before {
    content: ""; position: absolute; z-index: -1; left: var(--mx, 50%); top: var(--my, 100%); width: 10px; height: 10px; margin: -5px;
    border-radius: 50%; background: var(--c); transform: scale(0); transition: transform 0.8s var(--ease-out);
  }
  .svc-card:hover::before, .svc-card:focus-visible::before { transform: scale(260); }
  .svc-card:hover, .svc-card:focus-visible { color: var(--c-on); }
  .svc-card__top { display: flex; justify-content: space-between; align-items: center; padding: 4px 4px 0 8px; }
  .svc-card__n { font-size: 13px; }
  .svc-card__area { background: var(--c-fog); }
  .svc-card:hover .svc-card__area { background: var(--c-paper); color: var(--c-ink); }
  .svc-card__media { display: block; aspect-ratio: 16 / 11; overflow: hidden; border-radius: var(--r-media); background: var(--c-fog-2); }
  .svc-card__media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease-out), border-radius 1s var(--ease-out); }
  .svc-card:hover .svc-card__media :global(img) { transform: scale(1.06) rotate(-1deg); }
  .svc-card__name { padding: 8px 56px 0 8px; align-self: start; }
  .svc-card__short { padding: 0 8px; font-size: 15px; opacity: 0.78; max-width: 40ch; }
  .svc-card__go {
    position: absolute; right: 18px; bottom: 18px; width: 44px; height: 44px; border-radius: 50%;
    display: grid; place-items: center; background: var(--c-ink); color: var(--c-fog); font-size: 18px;
    transition: transform 0.5s var(--ease-out);
  }
  .svc-card__go span { transition: transform 0.5s var(--ease-out); }
  .svc-card:hover .svc-card__go { transform: scale(1.08); }
  .svc-card:hover .svc-card__go span { transform: rotate(-45deg); }
  .svc-card__name, .svc-card__short { position: relative; }
  .svc-card:focus-visible { outline-offset: 4px; }
  @media (max-width: 1023px) {
    .svc__label, .svc__title { grid-column: 1 / -1; }
    .svc__all { grid-column: 1 / -1; justify-self: start; }
    .svc__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) { .svc__grid { grid-template-columns: 1fr; } .svc-card__short { padding-right: 56px; } }
</style>

---
// Wordmark drawn in code (brand.md → Логотип): a rounded ink tile with three printed layers in filament
// colours, the top one still being laid down — plus ПРОТОТИП in Onest and LAB as a pill tag.
interface Props { tone?: 'dark' | 'light'; size?: number }
const { tone = 'dark', size = 30 } = Astro.props;
---
<span class={`logo logo--${tone}`} style={`--logo-size:${size}px`}>
  <svg class="logo__mark" viewBox="0 0 32 32" width={size} height={size} aria-hidden="true">
    <rect width="32" height="32" rx="10" class="logo__tile" />
    <rect x="7" y="20" width="18" height="4.2" rx="2.1" fill="#00c2ff" />
    <rect x="7" y="14" width="18" height="4.2" rx="2.1" fill="#ff2e8e" />
    <rect x="7" y="8" width="11" height="4.2" rx="2.1" fill="#b6f500" />
    <circle cx="22.5" cy="10.1" r="2.1" fill="#b6f500" />
  </svg>
  <span class="logo__word">ПРОТОТИП</span>{' '}<span class="logo__tag">LAB</span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; color: var(--c-ink); line-height: 1; }
  .logo--light { color: var(--c-fog); }
  .logo__mark { flex: none; }
  .logo__tile { fill: var(--c-ink); }
  .logo--light .logo__tile { fill: var(--c-ink-3); }
  .logo__word { font-family: var(--f-sans); font-weight: 600; font-size: calc(var(--logo-size) * 0.58); letter-spacing: -0.03em; }
  .logo__tag { font-family: var(--f-mono); font-weight: 600; font-size: calc(var(--logo-size) * 0.36); letter-spacing: 0.06em; background: currentColor; padding: 4px 7px 3px; border-radius: 999px; }
  .logo__tag { color: var(--c-fog); background: var(--c-ink); }
  .logo--light .logo__tag { color: var(--c-ink); background: var(--c-fog); }
</style>

---
// Wordmark drawn in code (brand.md → Логотип): a square mark with a "printed" corner —
// three layer lines and the amber nozzle dot — plus ПРОТОТИП in Geologica and LAB as a mono tag.
interface Props { tone?: 'dark' | 'light'; size?: number }
const { tone = 'dark', size = 28 } = Astro.props;
---
<span class={`logo logo--${tone}`} style={`--logo-size:${size}px`}>
  <svg class="logo__mark" viewBox="0 0 32 32" width={size} height={size} aria-hidden="true">
    <rect x="1" y="1" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2" />
    <path d="M1 1H31V13L13 31H1Z" fill="currentColor" />
    <path d="M17 31L31 17M21.5 31L31 21.5M26 31L31 26" stroke="currentColor" stroke-width="1.6" />
    <circle cx="16" cy="16" r="2.6" fill="var(--c-amber)" />
  </svg>
  <span class="logo__word">ПРОТОТИП</span>{' '}<span class="logo__tag">LAB</span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; color: var(--c-graphite); line-height: 1; }
  .logo--light { color: var(--c-primer); }
  .logo__mark { flex: none; }
  .logo__word { font-family: var(--f-sans); font-weight: 600; font-size: calc(var(--logo-size) * 0.6); letter-spacing: -0.02em; }
  .logo__tag { font-family: var(--f-mono); font-weight: 500; font-size: calc(var(--logo-size) * 0.4); letter-spacing: 0.08em; border: 1px solid currentColor; padding: 3px 5px 2px; border-radius: 2px; }
</style>

---
import ObjectSvg from './ObjectSvg.astro';
import { process } from '../data/site';
---
<section class="process chapter chapter--dark chapter--notch" data-process aria-labelledby="process-title">
  <div class="process__pin">
    <div class="wrap grid-12 process__grid">
      <div class="process__copy">
        <p class="t-label muted">Как мы работаем</p>
        <h2 id="process-title" class="t-h2 balance" data-reveal="lines">Один предмет. Пять этапов. Предсказуемый результат.</h2>
        <ol class="process__steps">
          {process.map((st, i) => (
            <li class="process__step" data-step={i}>
              <div class="process__frame" aria-hidden="true"><ObjectSvg state={i === 0 ? 0 : i === 1 ? 1 : i === 2 ? 2 : i === 3 ? 3 : 4} /></div>
              <p class="t-label process__n"><span class="t-num">{st.n}</span> / 05</p>
              <h3 class="t-h3">{st.title}</h3>
              <p class="process__text muted">{st.text}</p>
            </li>
          ))}
        </ol>
        <div class="process__rail" aria-hidden="true"><span data-rail></span></div>
      </div>
      <div class="process__stage" aria-hidden="true">
        <div class="process__viewport crop-marks">
          <canvas class="process__canvas"></canvas>
          <div class="process__sketch" data-sketch><ObjectSvg state={0} /></div>
          <p class="t-label t-num process__readout" data-readout>01 · Идея</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .process { padding-block: 0; }
  .process__pin { padding-block: var(--section-y); }
  .process__copy { grid-column: 1 / span 5; display: grid; gap: 32px; align-content: start; }
  .process__steps { display: grid; gap: 40px; counter-reset: s; }
  .process__step { display: grid; gap: 10px; border-top: 1px solid var(--c-line-dark); padding-top: 20px; }
  .process__n { color: var(--c-amber); }
  .process__frame { width: 180px; margin-bottom: 8px; background: var(--c-primer); padding: 12px; }
  .process__text { max-width: 44ch; color: var(--c-primer-muted); }
  .process__stage, .process__rail { display: none; }

  /* live mode (JS + 3D + wide screen): pinned, scroll-scrubbed */
  .process.is-live { height: 520vh; }
  .process.is-live .process__pin { position: sticky; top: 0; height: 100svh; padding-block: calc(var(--header-h) + 24px) 40px; display: flex; align-items: center; }
  .process.is-live .process__grid { width: 100%; align-items: center; }
  .process.is-live .process__frame { display: none; }
  .process.is-live .process__steps { gap: 0; position: relative; }
  .process.is-live .process__step {
    grid-area: 1 / 1; opacity: 0; transform: translateY(24px); pointer-events: none; border-top: 0; padding-top: 0;
    transition: opacity .6s var(--ease-out), transform .8s var(--ease-out);
  }
  .process.is-live .process__steps { display: grid; }
  .process.is-live .process__step.is-active { opacity: 1; transform: none; }
  .process.is-live .process__rail { display: block; height: 2px; background: var(--c-line-dark); position: relative; margin-top: 8px; }
  .process__rail span { position: absolute; inset: 0 auto 0 0; width: 100%; background: var(--c-amber); transform-origin: 0 50%; transform: scaleX(0); }
  .process.is-live .process__stage { display: block; grid-column: 7 / span 6; }
  .process__viewport { position: relative; aspect-ratio: 1 / 1; color: var(--c-primer); border: 1px solid var(--c-line-dark); background: var(--c-primer); }
  .process__canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .process__sketch { position: absolute; inset: 10% 20% 8%; pointer-events: none; }
  .process__readout { position: absolute; left: 16px; top: 16px; margin: 0; color: var(--c-graphite); }

  @media (max-width: 1023px) {
    .process__copy { grid-column: 1 / -1; }
  }
</style>

---
import { getImage } from 'astro:assets';
import still from '../assets/hero-still.webp';
import stillM from '../assets/hero-still-m.webp';
import { site } from '../data/site';
const states = ['Каркас', 'Печать', 'Шёлк PLA', 'Смола SLA'];
// static render of the same scene (scripts: hero3d still) — shown when 3D is not run
const d = await Promise.all([1000, 1600, 2400].map((w) => getImage({ src: still, width: w, format: 'webp', quality: 78 })));
const m = await Promise.all([420, 748].map((w) => getImage({ src: stillM, width: w, format: 'webp', quality: 78 })));
const srcset = (a: { src: string; attributes: Record<string, any> }[], ws: number[]) => a.map((x, i) => `${x.src} ${ws[i]}w`).join(', ');
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__stage on-dark" data-hero-object>
    <canvas class="hero__canvas" aria-hidden="true"></canvas>
    <div class="hero__still" aria-hidden="true">
      <picture>
        <source media="(max-width: 767px)" srcset={srcset(m, [420, 748])} sizes="100vw" />
        <img src={d[1].src} srcset={srcset(d, [1000, 1600, 2400])} sizes="100vw" alt="" width="2832" height="1520" decoding="async" />
      </picture>
    </div>
    <div class="hero__top">
      <p class="chip hero__kicker"><i style="--c: var(--f-lime)"></i>{site.city} · студия полного цикла</p>
      <p class="chip hero__readout t-num" aria-live="polite"><span data-layer>Шёлк PLA · слой 0,2 мм</span></p>
    </div>
    <h1 id="hero-title" class="hero__title balance" data-reveal="lines">Мы не печатаем файлы. <span class="grad-text">Мы создаём изделия.</span></h1>
    <div class="hero__states" role="group" aria-label="Материал и технология">
      {states.map((s, i) => (
        <button type="button" class="hero-state" data-state={i} aria-pressed={i === 2 ? 'true' : 'false'}>{s}</button>
      ))}
    </div>
  </div>
  <div class="cross-rule hero__rule" aria-hidden="true"><span>+</span><span>+</span><span>+</span><span>+</span><span>+</span></div>
  <div class="wrap grid-12 hero__below">
    <p class="t-body-l hero__lead pretty">Моделирование, 3D-сканирование, печать FDM и SLA, шлифовка, грунт, покраска и сборка — в одной студии. На старте достаточно идеи, фотографии или эскиза.</p>
    <div class="hero__actions">
      <a href="/raschet/" class="btn"><span class="dot" aria-hidden="true"></span>Рассчитать проект <span class="arr" aria-hidden="true">→</span></a>
      <a href={site.telegram.url} class="btn btn--ghost" rel="noopener" target="_blank">Написать в Telegram</a>
    </div>
    <p class="t-label muted hero__scroll" aria-hidden="true">Листайте — нить уже печатается</p>
  </div>
</section>

<style>
  .hero { position: relative; z-index: 1; padding-top: var(--header-h); }
  .hero__stage {
    container: stage / size;
    position: relative; overflow: hidden; isolation: isolate;
    margin-inline: var(--inset); height: calc(100svh - var(--header-h) - 64px); min-height: 560px; max-height: 1100px;
    border-radius: var(--r-card); background: linear-gradient(180deg, var(--c-ink-2), var(--c-ink) 70%); color: var(--c-fog);
  }
  .hero__canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; }
  .hero__still { position: absolute; inset: 0; z-index: 0; opacity: 0; transition: opacity 0.8s var(--ease-out); }
  .hero__still :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 70% 50%; }
  :global(.is-static) .hero__still { opacity: 1; }
  :global(.is-static) .hero__canvas { display: none; }
  .hero__stage:not(.is-live) .hero__canvas { opacity: 0; }
  .hero__canvas { transition: opacity 0.8s var(--ease-out); }

  .hero__top { position: absolute; inset: 16px 16px auto 16px; z-index: 2; display: flex; justify-content: space-between; gap: 8px; pointer-events: none; }
  .hero__kicker, .hero__readout { background: rgba(37, 40, 51, 0.8); color: var(--c-fog); min-height: 34px; }
  .hero__title {
    position: absolute; left: clamp(20px, 3vw, 48px); bottom: clamp(88px, 11cqh, 120px); z-index: 2; margin: 0;
    max-width: 11.5ch; font-size: clamp(44px, 6.4vw, 128px); line-height: 0.92; letter-spacing: -0.055em; font-weight: 350;
    pointer-events: none; hyphens: manual;
  }
  .hero__states {
    position: absolute; left: clamp(20px, 3vw, 48px); bottom: clamp(20px, 3vw, 40px); z-index: 2;
    display: flex; gap: 2px; padding: 4px; border-radius: var(--r-pill); background: rgba(37, 40, 51, 0.8);
  }
  .hero-state {
    min-height: 40px; padding: 0 16px; border-radius: var(--r-pill); color: var(--c-muted-dark); font-size: 14px; font-weight: 500; white-space: nowrap;
    transition: background-color var(--d-fast) var(--ease-hover), color var(--d-fast) var(--ease-hover);
  }
  .hero-state:hover { color: var(--c-fog); }
  .hero-state[aria-pressed="true"] { background: var(--c-fog); color: var(--c-ink); }

  .hero__rule { margin-top: 18px; }
  .hero__below { padding-block: clamp(28px, 4vw, 64px) clamp(40px, 5vw, 96px); align-items: end; }
  .hero__lead { grid-column: 1 / span 5; max-width: 46ch; }
  .hero__actions { grid-column: 7 / span 4; display: flex; flex-wrap: wrap; gap: 10px; }
  .hero__scroll { grid-column: 11 / span 2; justify-self: end; text-align: right; max-width: 18ch; }

  @container stage (max-aspect-ratio: 6/5) {
    .hero__title { bottom: 88px; right: 20px; max-width: 12ch; }
  }
  @media (max-width: 1023px) {
    .hero__lead, .hero__actions { grid-column: 1 / -1; }
    .hero__scroll { display: none; }
  }
  @media (max-width: 767px) {
    .hero__stage { height: calc(100svh - var(--header-h) - 40px); min-height: 520px; }
    .hero__title { font-size: clamp(40px, 11.5vw, 64px); left: 16px; bottom: 84px; }
    .hero__states { left: 12px; right: 12px; bottom: 12px; overflow-x: auto; scrollbar-width: none; }
    .hero-state { padding: 0 13px; font-size: 13px; flex: 1 0 auto; }
    .hero__readout { display: none; }
    .hero__top { inset: 12px 12px auto 12px; }
  }
</style>

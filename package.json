{
  "name": "prototiplab-site",
  "private": true,
  "type": "module",
  "version": "2.0.0",
  "description": "ПРОТОТИП LAB — сайт студии 3D-моделирования, сканирования и производства",
  "scripts": {
    "start": "npm install && astro dev --host 127.0.0.1 --port 4321",
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "gate": "node scripts/read-styles.mjs && node scripts/assert-styles.mjs --assertions clone-workspace/prototiplab/03-design-spec/assertions.json --clone-styles clone-workspace/prototiplab/06-qa/latest/clone-styles.json --out clone-workspace/prototiplab/06-qa/latest/metrics.json",
    "qa:interactions": "node scripts/e2e.mjs",
    "qa:banned": "node scripts/check-banned.mjs",
    "qa:lighthouse": "node scripts/lighthouse.mjs",
    "qa": "npm run gate && npm run qa:interactions && npm run qa:banned",
    "og": "node scripts/og.mjs",
    "photos": "python3 scripts/regrade-photos.py",
    "redirects": "node scripts/legacy-redirects.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "astro": "^7.3.5",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "sharp": "^0.35.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright": "^1.61.1",
    "typescript": "^7.0.2"
  }
}
